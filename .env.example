# Copy to .env and fill in values before running in production.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=postgresql+asyncpg://ratemyalbum:ratemyalbum_secret@localhost:5432/ratemyalbum
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=                   # REQUIRED in production — must be a strong random value
ENVIRONMENT=development       # Set to "production" for production deployments
DEBUG=false                   # Must be false in production

LASTFM_API_KEY=               # Optional
