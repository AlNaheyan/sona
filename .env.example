# Database
POSTGRES_USER=ratemyalbum
POSTGRES_PASSWORD=ratemyalbum_secret
POSTGRES_DB=ratemyalbum
DATABASE_URL=postgresql+asyncpg://ratemyalbum:ratemyalbum_secret@db:5432/ratemyalbum

# Redis
